{
  // 任务面板（⇧⌘B / Ctrl+Shift+B 可直接运行「全量校验」）
  // 说明：本工程自带零依赖本地服务器 tools/serve.js，无需 npm 安装任何包。
  // 校验脚本按 file(line,col): error: msg 格式输出，VS Code 会解析为可点击的诊断。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动本地预览服务",
      "detail": "零依赖静态服务器，默认 http://127.0.0.1:5180/ （Ctrl+C 停止）",
      "type": "shell",
      "command": "node tools/serve.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-preview-server",
        // 后台服务不产出诊断：用永不匹配的正则，避免每行输出被误报为问题
        "pattern": [
          {
            "regexp": "^(?!.*)"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*正在启动本地预览服务.*$",
          "endsPattern": "^.*已就绪.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": false
      }
    },
    {
      "label": "① 语法闸门",
      "detail": "对全部内联脚本与 risk-src 模块做语法校验（只编译不执行）",
      "type": "shell",
      "command": "node tools/check-syntax.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "js-syntax",
        "pattern": [
          {
            "regexp": "^\\s*(.+?)\\((\\d+),(\\d+)\\):\\s*(error|warning|info):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "② 引用完整性校验",
      "detail": "校验全部 src/href 本地引用是否可解析到真实文件",
      "type": "shell",
      "command": "node tools/check-links.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "ref-integrity",
        "pattern": [
          {
            "regexp": "^\\s*(.+?)\\((\\d+),(\\d+)\\):\\s*(error|warning|info):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "全量校验（语法 + 引用）",
      "detail": "默认构建任务，⇧⌘B 触发",
      "dependsOrder": "sequence",
      "dependsOn": [
        "① 语法闸门",
        "② 引用完整性校验"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "重新组装风险识别系统页面",
      "detail": "改写 risk-src/tools/pages-src/ 后运行，产物写入 risk-src/pages/",
      "type": "shell",
      "command": "python3 risk-src/tools/build-pages.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "生成旧版对照基准页",
      "detail": "由 risk/ 下的运行版页面生成 risk-src/tools/legacy/ 基准（仅注入时刻冻结钩子）",
      "type": "shell",
      "command": "python3 risk-src/tools/build-legacy.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "界面等价性自检",
      "detail": "逐页冻结 23 个监测时刻，比对 DOM 文本与全部 ECharts 配置（需 agent-browser CLI）",
      "type": "shell",
      "command": "bash risk-src/tools/dom-diff.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "打包 ZIP",
      "detail": "排除 .git / node_modules / 原有压缩包，输出到上级目录",
      "type": "shell",
      "command": "bash tools/make-zip.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
